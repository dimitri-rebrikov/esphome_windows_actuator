# ESPHome secrets — copy this file to `secrets.yaml` and fill in real values.
# `secrets.yaml` is ignored by git and must never be committed.

# Wi-Fi network the device connects to.
wifi_ssid: "your-wifi-ssid"
wifi_password: "your-wifi-password"

# Password for the fallback hotspot (first provisioning only).
fallback_password: "change-me"

# ESPHome native API encryption key (base64, 32 bytes).
# Protects both the API connection and OTA updates.
# Generate with:  openssl rand -base64 32
api_encryption_key: "REPLACE_WITH_BASE64_KEY"
